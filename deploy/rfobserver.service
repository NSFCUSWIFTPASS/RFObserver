[Unit]
Description=RFObserver Sensor Pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rfobserver
Group=rfobserver
# Config lives in a writable .env in the state dir (not an EnvironmentFile under
# read-only /etc). WorkingDirectory makes that .env the one both the app reads on
# startup and the UI writes on toggle/apply, so runtime changes persist across
# restarts. Do NOT add an EnvironmentFile: its env vars would outrank the .env
# and silently override UI-persisted changes.
# systemd creates/owns /var/lib/rfobserver as the service user on every start,
# so the SQLite DB and .env there are always writable (no "readonly database").
StateDirectory=rfobserver
WorkingDirectory=/var/lib/rfobserver
ExecStart=/usr/local/bin/rfobserver run
# The web UI serves on port 80 (RFOBS_WEB_PORT in the .env): this one
# capability lets the unprivileged service user bind ports below 1024, and
# nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Memory backstop: if a bug blows past this, OOM-kill just this service (then
# Restart=on-failure brings it back) instead of freezing the whole board. Tune
# per box (sized for a ~7-8 GB sensor).
MemoryHigh=3G
MemoryMax=4G
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rfobserver

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rfobserver /tmp/rfobserver

[Install]
WantedBy=multi-user.target
